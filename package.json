{
  "name": "exam-tracking-system",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "caniuse-lite": "^1.0.30001806",
    "concurrently": "^10.0.5",
    "dotenv-cli": "^11.0.0",
    "drizzle-orm": "^0.45.2",
    "lodash": "^4.18.1",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "dev": "dotenv -e .env -- concurrently -n backend,frontend -c blue,green \"npm:backend:dev\" \"npm:frontend:dev\"",
    "dev:backend": "dotenv -e .env -- npm run start:dev -w apps/backend",
    "dev:frontend": "npm run dev -w apps/frontend",
    "dev:build": "concurrently -n backend,frontend -c blue,green \"npm:backend:build\" \"npm:frontend:build\"",
    "backend:build": "npm run build -w apps/backend",
    "frontend:build": "npm run build -w apps/frontend",
    "build": "concurrently -n backend,frontend -c blue,green \"npm:backend:build\" \"npm:frontend:build\"",
    "backend:dev": "npm run start:dev -w apps/backend",
    "frontend:dev": "npm run dev -w apps/frontend",
    "db:generate": "npm run db:generate -w apps/backend",
    "db:migrate": "npm run db:migrate -w apps/backend",
    "db:migrate:all": "npm run db:migrate:all -w apps/backend",
    "db:seed": "npm run db:seed -w apps/backend",
    "lint": "npm run lint -w apps/backend && npm run lint -w apps/frontend",
    "typecheck": "npm run typecheck -w apps/backend && npm run typecheck -w apps/frontend"
  }
}
