{
  "name": "exam-tracking-system",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "caniuse-lite": "^1.0.30001806",
    "drizzle-orm": "^0.45.2",
    "lodash": "^4.18.1",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "backend:dev": "npm run start:dev -w apps/backend",
    "frontend:dev": "npm run dev -w apps/frontend",
    "db:generate": "npm run db:generate -w apps/backend",
    "db:migrate": "npm run db:migrate -w apps/backend",
    "lint": "npm run lint -w apps/backend && npm run lint -w apps/frontend",
    "typecheck": "npm run typecheck -w apps/backend && npm run typecheck -w apps/frontend"
  }
}
